# ============================================================
# Easy Search â€” variables de entorno
# Copia este archivo como ".env" (en la misma carpeta) y cambia los valores.
# El archivo .env NO se sube a GitHub.
# ============================================================

# --- Base de datos (la usan Docker y el backend) ---
POSTGRES_USER=easysearch
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=easysearch
# Puerto de tu PC donde se expone PostgreSQL (5440 para no chocar con otros PostgreSQL de tu PC)
POSTGRES_PORT=5440

# URL que usa el backend para conectarse (debe coincidir con los valores de arriba)
DATABASE_URL=postgresql+psycopg://easysearch:cambia_esta_clave@127.0.0.1:5440/easysearch

# --- Backend ---
APP_ENV=development
# OrÃ­genes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Autenticación ---
# Clave secreta para firmar los tokens JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esta_clave_secreta
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Inteligencia artificial (Google Gemini) ---
# Crea tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo principal y de respaldo (si el principal está saturado)
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- Correo para los códigos de confirmación (Gmail gratis) ---
# 1) Activa la verificación en dos pasos: https://myaccount.google.com/security
# 2) Crea una "contraseña de aplicación": https://myaccount.google.com/apppasswords
# Sin SMTP en desarrollo, el código aparece en la terminal del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Easy Search

# --- Anti-robots: Cloudflare Turnstile (gratis) ---
# En local puedes usar las claves de PRUEBA de Cloudflare (siempre aprueban):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# En producción crea las reales en https://dash.cloudflare.com → Turnstile. Vacías = desactivado (solo desarrollo).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Búsquedas de prueba sin cuenta ---
# Cada visitante (por IP) puede buscar estas veces cada 24 horas; el tope diario cuenta a TODOS los invitados
# y protege la cuota de la IA aunque alguien cambie de IP.
GUEST_SEARCHES_PER_DAY=3
GUEST_SEARCHES_DAILY_TOTAL=300

# --- Tráfico en vivo: TomTom (gratis, ~2.500 consultas al día, sin tarjeta) ---
# Crea la clave en https://developer.tomtom.com (My dashboard → Keys). Vacía = sin avisos de trancón.
# La ubicación del usuario se redondea a ~200 m antes de enviarse a TomTom.
TOMTOM_API_KEY=
TOMTOM_DAILY_LIMIT=2300
