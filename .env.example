# ============================================================
# Easy Search â€” variables de entorno
# Copia este archivo como ".env" (en la misma carpeta) y cambia los valores.
# El archivo .env NO se sube a GitHub.
# ============================================================

# --- Base de datos (la usan Docker y el backend) ---
POSTGRES_USER=easysearch
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=easysearch
# Puerto de tu PC donde se expone PostgreSQL (5440 para no chocar con otros PostgreSQL de tu PC)
POSTGRES_PORT=5440

# URL que usa el backend para conectarse (debe coincidir con los valores de arriba)
DATABASE_URL=postgresql+psycopg://easysearch:cambia_esta_clave@127.0.0.1:5440/easysearch

# --- Backend ---
APP_ENV=development
# OrÃ­genes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Autenticación ---
# Clave secreta para firmar los tokens JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esta_clave_secreta
ACCESS_TOKEN_EXPIRE_MINUTES=120
