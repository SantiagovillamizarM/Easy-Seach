      "name": "04 · Búsqueda",
      "description": "Búsqueda en lenguaje natural y recomendaciones con IA (en esta prueba responde Gemini).",
      "item": [
        {
          "name": "Buscar en lenguaje natural",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve JSON\", () => pm.response.to.be.json);",
                  "const j = pm.response.json();",
                  "pm.test(\"Entendió que es una búsqueda\", () => pm.expect(j.interpretation.is_search).to.be.true);",
                  "pm.test(\"La interpretó una IA o las reglas\", () => pm.expect(j.interpretation.parser).to.be.oneOf([\"xai\", \"openai\", \"gemini\", \"reglas\"]));",
                  "pm.test(\"Encontró resultados\", () => pm.expect(j.results.length).to.be.above(0));",
                  "pm.environment.set(\"result_id\", j.results[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/search",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "search"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"hamburguesas en piedecuesta\",\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
