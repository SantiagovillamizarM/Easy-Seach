{
  "info": {
    "_postman_id": "39e77af7-d58a-5477-a121-20d3202fac13",
    "name": "Easy Search · API",
    "description": "Colección de pruebas de la API de Easy Search. Todas las peticiones van a la puerta de entrada Spring Boot (`{{base_url}}`), que atiende el asistente y reenvía lo demás a FastAPI.\n\n1. Importa esta colección y el entorno `EasySearch.local.postman_environment.json`.\n2. Llena `user_email`/`user_password` (y `admin_*`), o pega directamente `token` y `admin_token`.\n3. Ejecuta la colección completa (Run collection) o con Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Responde en menos de 30 s\", () => pm.expect(pm.response.responseTime).to.be.below(30000));"
        ]
      }
    }
  ],
