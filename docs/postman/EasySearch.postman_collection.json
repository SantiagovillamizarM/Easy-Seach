    {
      "name": "02 · Cuenta",
      "description": "Sesión con token JWT. Con el anti-robots (Turnstile) activo, el login sin captcha se rechaza: en ese caso pega tu token en la variable `token` del entorno (o usa las claves de prueba de Cloudflare).",
      "item": [
        {
          "name": "Iniciar sesión (sin captcha)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 o 400\", () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"token\", pm.response.json().access_token);",
                  "  pm.test(\"Devuelve un token\", () => pm.expect(pm.response.json().access_token).to.be.a(\"string\"));",
                  "} else {",
                  "  pm.test(\"Pide el anti-robots\", () => pm.expect(pm.response.json().detail).to.match(/robot/i));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{user_email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{user_password}}",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Iniciar sesión con contraseña incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400 o 401\", () => pm.expect(pm.response.code).to.be.oneOf([400, 401]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
