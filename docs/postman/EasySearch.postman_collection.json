                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Estado final válido\", () => pm.expect(j.estado).to.be.oneOf([\"RESPONDIDA\", \"SIN_RESULTADOS\", \"ERROR\"]));",
                  "pm.test(\"Guarda el umbral usado\", () => pm.expect(j.umbral).to.be.a(\"number\"));",
                  "if (j.estado === \"RESPONDIDA\") {",
                  "  pm.test(\"Trae fuentes con similitud\", () => j.respuesta.fuentes.forEach(f => pm.expect(f.similitud).to.be.at.least(j.umbral)));",
                  "}",
                  "pm.environment.set(\"consulta_id\", j.id);",
                  "pm.environment.set(\"consulta_respondida\", j.estado === \"RESPONDIDA\");"
